# ==============================================================================
# DevOpsPilot Environment Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# GitHub Integration (Option A: Personal Access Token)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_here

# ------------------------------------------------------------------------------
# GitHub Integration (Option B: GitHub App Authentication - 100% Free, No fees)
# ------------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_APP_INSTALLATION_ID=

# ------------------------------------------------------------------------------
# LLM Orchestration
# ------------------------------------------------------------------------------
# Active provider: "gemini" (Google AI Studio) or "groq" (Groq Cloud)
LLM_PROVIDER=gemini

# Google AI Studio (Free tier - Gemini 2.5 Flash with 1M context window)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud (Free tier - Ultra-fast inference with Llama 3.3 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Workspace and Ephemeral Sandboxing
# ------------------------------------------------------------------------------
WORKSPACE_BASE_DIR=./workspaces
DOCKER_SANDBOX_IMAGE=node:20-alpine
DOCKER_TIMEOUT_SECONDS=120
USE_DOCKER_SANDBOX=true

# ------------------------------------------------------------------------------
# Agent Guardrails & Limits
# ------------------------------------------------------------------------------
MAX_RETRY_ITERATIONS=3
MAX_LOG_LINES=150
ENABLE_SECRET_SCANNING=true
