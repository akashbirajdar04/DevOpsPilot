# ==============================================================================
# HealOps: Autonomous Self-Healing CI/CD GitHub App Configuration
# ==============================================================================

# GitHub App Authentication
APP_ID=5467590
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEogIBAAKCAQEA0...\n-----END RSA PRIVATE KEY-----"
WEBHOOK_SECRET=your_github_app_webhook_secret_here

# ------------------------------------------------------------------------------
# Webhook Ingestion Mode:
# - FOR LOCAL DEV: Set WEBHOOK_PROXY_URL to your smee.io channel URL.
# - FOR AWS EC2: Comment out or leave WEBHOOK_PROXY_URL blank.
#   GitHub will post directly to: http://<EC2-IP>:3000/api/github/webhooks
# ------------------------------------------------------------------------------
# WEBHOOK_PROXY_URL=https://smee.io/your_smee_channel_here

# LLM Orchestration (Groq Engine)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TURN_DELAY_MS=2000

# Operational & Server Settings
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
MAX_RETRY_ITERATIONS=3
