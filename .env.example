# ==============================================================================
# DevOpsPilot Environment Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# GitHub App / Personal Access Token Integration
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_here

# LLM Orchestration (Google GenAI / Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Workspace and Sandboxing
WORKSPACE_BASE_DIR=./workspaces
DOCKER_SANDBOX_IMAGE=node:20-alpine
DOCKER_TIMEOUT_SECONDS=120
USE_DOCKER_SANDBOX=true

# Agent Guardrails & Limits
MAX_RETRY_ITERATIONS=3
MAX_LOG_LINES=150
ENABLE_SECRET_SCANNING=true
