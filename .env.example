# ==============================================================================
# HealOps: Autonomous Self-Healing CI/CD GitHub App Configuration
# ==============================================================================

# GitHub App Authentication
APP_ID=123456
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEogIBAAKCAQEA0...\n-----END RSA PRIVATE KEY-----"
WEBHOOK_SECRET=your_github_app_webhook_secret_here
# Smee.io Public Webhook Tunnel for local development
WEBHOOK_PROXY_URL=https://smee.io/your_smee_channel_here

# LLM Orchestration (Groq Engine)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Operational Settings
PORT=3000
LOG_LEVEL=info
MAX_RETRY_ITERATIONS=10
